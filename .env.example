# Copy to .env and fill in real values. Never commit secrets.

PORT=3123

# WeCom webhook (choose one)
# Full URL (recommended)
GW_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Or key only
# GW_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# markdown | news | text
GW_MSGTYPE=markdown

# Only forward these Environment values (comma-separated)
# GW_ONLY_ENV=production,prod

# text message @ mobiles; use @all to notify everyone
# GW_MENTIONED_MOBILES=@all

# Optional cover image for news messages
# GW_PIC_URL=
